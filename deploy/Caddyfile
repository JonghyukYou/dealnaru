{
	email {$ACME_EMAIL}
}

www.{$SITE_DOMAIN:dealnaru.life} {
	redir https://{$SITE_DOMAIN:dealnaru.life}{uri} permanent
}

{$SITE_DOMAIN:dealnaru.life} {
	encode zstd gzip
	root * /srv

	header {
		-X-Powered-By
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' https: data:; font-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'"
	}
	@unlisted path /admin /admin/* /login /register /verify-email /wishlist /notifications /api/*
	header @unlisted Cache-Control "no-store"

	@disabled path /api/dev /api/dev/* /api/admin/dev /api/admin/dev/* /api/admin/collect-price /docs /docs/* /redoc /openapi.json
	handle @disabled {
		respond 404
	}
	handle /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@spa path / /games /games/* /software /software/* /used-market /login /register /verify-email /wishlist /notifications /admin /terms /privacy
	handle @spa {
		try_files {path} /index.html
		header Cache-Control "no-store"
		file_server
	}
	handle {
		file_server
	}
}
