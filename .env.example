# Copy to .env in the project root for Docker Compose only. See docs/DEPLOYMENT_KO.md.
SITE_DOMAIN=dealnaru.life
POSTGRES_PASSWORD=
DB_APP_PASSWORD=
ITAD_API_KEY=
# Enable only after checking permission for public use of collected listings.
USED_MARKET_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=
ACME_EMAIL=
# Enable from Admin after the initial data check.
AUTO_REFRESH_ENABLED=false
# Public values embedded in the website at build time. Never use credentials here.
# Use the repository web URL, e.g. https://github.com/YOUR_ACCOUNT/dealnaru (no .git).
VITE_REPOSITORY_URL=
VITE_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=
VITE_HOSTING_NOTICE=
VITE_MAIL_NOTICE=
VITE_RETENTION_NOTICE=
VITE_PRIVACY_OFFICER=
VITE_OVERSEAS_NOTICE=
